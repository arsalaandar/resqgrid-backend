DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/resqgrid
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/resqgrid_test

APP_ENV=development
OTP_PROVIDER=console
OTP_HMAC_SECRET=generate-with-secrets.token_urlsafe-48
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_DAY=10

JWT_SECRET_KEY=generate-a-different-value-with-secrets.token_urlsafe-48
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=resqgrid-api
JWT_AUDIENCE=resqgrid-mobile

# Use a shared store such as redis://localhost:6379/0 in staging/production.
RATE_LIMIT_STORAGE_URI=memory://
